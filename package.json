    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "typescript",
    "utility",
    "javascript",
    "match-media-screen"
  ],
  "author": {
    "name": "phucbm",
    "url": "https://github.com/phucbm"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phucbm/match-media-screen"
  },
  "bugs": {
    "url": "https://github.com/phucbm/match-media-screen/issues"
  },
  "homepage": "https://github.com/phucbm/match-media-screen",
  "devDependencies": {
    "@phucbm/banner": "^0.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
